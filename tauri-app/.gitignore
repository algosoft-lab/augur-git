# Dependencies
node_modules/

# Vite build output
dist/
dist-ssr/
*.local

# Rust build output. The Tauri CLI builds the Rust workspace under src-tauri,
# so the root /target rule does not cover it.
/src-tauri/target/
/src-tauri/gen/

# The CLI companion is produced by `npm run sidecar`; only the placeholder the
# build script writes when running plain `cargo build` lands here.
/src-tauri/binaries/

# Test output
coverage/
*.lcov
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Editor and OS noise
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
