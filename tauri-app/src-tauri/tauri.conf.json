{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Augur Git Tauri",
  "version": "0.1.0",
  "identifier": "com.augur.git.tauri",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Augur Git Tauri",
        "url": "index.html?window=main",
        "width": 1280,
        "height": 800,
        "minWidth": 860,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Review-first desktop Git client",
    "longDescription": "Augur Git Tauri is a local-first, review-first desktop Git client. It turns local repository changes into clear, navigable diffs so a human can understand, select, and approve what becomes part of the project's history.",
    "copyright": "Copyright (c) Augur Git contributors",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/augurgit-tauri"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  }
}
