{
  "name": "augur-git-tauri",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Review-first desktop Git client built with Tauri, React, and Vite",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "format": "prettier --write \"**/*.{ts,tsx}\" && cargo fmt --all --manifest-path src-tauri/Cargo.toml",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "bun run typecheck && bun run test && bun run test:e2e",
    "tauri": "tauri",
    "tauri:dev": "bun scripts/sidecar.mjs && tauri dev",
    "tauri:build": "bun scripts/sidecar.mjs && tauri build",
    "package:windows": "bun packaging/build-windows.mjs",
    "package:macos": "bun packaging/build-macos.mjs",
    "package:linux": "bun packaging/build-linux.mjs",
    "cli:build": "cargo build --release --bin augurgit-tauri --manifest-path src-tauri/Cargo.toml",
    "sidecar": "bun scripts/sidecar.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.4.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.6.0",
    "@tauri-apps/plugin-store": "^2.5.0",
    "@tauri-apps/plugin-window-state": "^2.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
